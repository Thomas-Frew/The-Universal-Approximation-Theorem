{
  "name": "universal-approximation-theorem",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm --filter @uat/api verify",
    "tunnel": "pnpm --filter @uat/api tunnel",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "db:generate": "pnpm --filter @uat/api db:generate",
    "db:migrate": "pnpm --filter @uat/api db:migrate",
    "db:reset": "pnpm --filter @uat/api db:reset"
  }
}
