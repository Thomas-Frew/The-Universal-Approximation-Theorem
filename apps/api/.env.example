# Postgres, as started by `pnpm db:up` (see compose.yaml at the repo root).
DATABASE_URL=postgres://uat:uat@localhost:5432/uat

# Signs session cookies. At least 32 random characters, different in every
# environment, never committed. Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address the browser loads the game from. Locally that is Vite, which
# forwards /api to this server, so the browser never sees port 8787.
BETTER_AUTH_URL=http://localhost:5173

# A checkout of the levels repo, relative to apps/api.
LEVELS_DIR=../../../TUAT-Problems

# The public demo: only the first level, and a "coming soon" message once it is solved.
DEMO_MODE=true

# Keep details that player-facing messages normally trim, e.g. "(stdin, line 1)".
# DEBUG=true

# Where Judge0 is. Leave unset to run without submissions.
# For local work, keep `pnpm tunnel` running in another terminal: it forwards
# this localhost port to Judge0 on the droplet named by JUDGE0_SSH_HOST.
# JUDGE0_URL=http://localhost:2358
# JUDGE0_SSH_HOST=root@<judge droplet ip>
